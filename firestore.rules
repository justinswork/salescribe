rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read/write only their own memos subtree.
    // Memo IDs are client-generated UUIDs; no listing across users.
    match /users/{uid}/memos/{memoId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user rate-limit + usage counters (usage/{uid}). Written ONLY by the
    // server via the Admin SDK, which bypasses these rules. Clients must never
    // read or tamper with their own quota — explicit deny (redundant with the
    // default-deny below, but stated so the intent is obvious).
    match /usage/{uid} {
      allow read, write: if false;
    }

    // Default-deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
