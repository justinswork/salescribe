rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email; }

    function isMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function isAdmin(orgId) {
      return isMember(orgId) &&
        get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // A user may belong to an org iff it's their own personal org, or the org
    // id equals their verified email's domain. Company org ids ARE the
    // lowercased domain, so a full-match regex over the email is the check.
    function mayJoin(orgId) {
      return verified() && (
        orgId == 'personal-' + request.auth.uid ||
        myEmail().lower().matches('.*@' + orgId)
      );
    }

    // There is a pending invite for the caller's email in this org.
    function hasInvite(orgId) {
      return verified() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/invites/$(myEmail().lower()));
    }

    // Per-user profile: pointer to the one org the user belongs to. Only the
    // user themselves reads/writes it; it grants no access on its own (all
    // access is gated by membership docs below).
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /orgs/{orgId} {
      // Members, eligible domain joiners, and invitees can read the org doc
      // (the last two need it during the join/bootstrap flow).
      allow read: if isMember(orgId) || mayJoin(orgId) || hasInvite(orgId);
      allow create: if mayJoin(orgId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin(orgId);
      allow delete: if false;

      match /members/{uid} {
        // You can always read your own membership record (needed during
        // bootstrap); the rest of the roster is readable once you're a member.
        allow read: if request.auth.uid == uid || isMember(orgId);
        // Self-join. Via domain: 'member', or 'admin' only if you created the
        // org. Via a pending invite: 'member' only (admins promote afterward).
        allow create: if request.auth.uid == uid && (
          (mayJoin(orgId) && (
            request.resource.data.role == 'member' ||
            (request.resource.data.role == 'admin' &&
              get(/databases/$(database)/documents/orgs/$(orgId)).data.createdBy == request.auth.uid)
          ))
          || (hasInvite(orgId) && request.resource.data.role == 'member')
        );
        // Admins manage the roster (including roles). You can update your own
        // record but NOT change your own role (no self-promotion). You can
        // always remove yourself (leave the org).
        allow update: if isAdmin(orgId) ||
          (request.auth.uid == uid && request.resource.data.role == resource.data.role);
        allow delete: if isAdmin(orgId) || request.auth.uid == uid;
      }

      // Pending invites, keyed by the invited email (lowercased). Admins manage
      // them; a member can see the pending list; an invitee can read and
      // consume (delete) their own.
      match /invites/{emailKey} {
        allow read: if isMember(orgId) || (verified() && emailKey == myEmail().lower());
        allow create, update: if isAdmin(orgId)
          && request.resource.data.email.lower() == emailKey;
        allow delete: if isAdmin(orgId) || (verified() && emailKey == myEmail().lower());
      }

      match /memos/{memoId} {
        // Shared memos are readable by any member; private memos only by their
        // author. This is the hard privacy boundary — a teammate can't even
        // read a private memo, so it can never leak into a shared briefing.
        allow read: if isMember(orgId) && (
          resource.data.visibility == 'shared' ||
          resource.data.authorUid == request.auth.uid
        );
        allow create: if isMember(orgId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.visibility in ['shared', 'private'];
        // The author can always edit/delete their own memo; an admin can edit/
        // delete any SHARED memo (they can't read, so can't touch, private ones).
        allow update, delete: if isMember(orgId) && (
          resource.data.authorUid == request.auth.uid ||
          (isAdmin(orgId) && resource.data.visibility == 'shared')
        );
      }

      // Per-org counters (e.g. the memo sequence number). Any member may read
      // and increment; the value is low-stakes and set in a client transaction.
      match /counters/{name} {
        allow read, write: if isMember(orgId);
      }
    }

    // Per-user rate-limit + usage counters. Written ONLY by the server via the
    // Admin SDK, which bypasses these rules. Clients get no access.
    match /usage/{uid} {
      allow read, write: if false;
    }

    // Default-deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
