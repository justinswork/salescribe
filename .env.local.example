# Server-only secrets (never shipped to the client).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# API-route auth. Locally, auth is DISABLED by default so `npm run dev` and
# `npm run eval` work without a Firebase session — leave these unset.
#   - SALESCRIBE_SERVICE_TOKEN: shared bearer token for server-to-server
#     callers (evals). If set, `npm run eval` sends it automatically. In
#     production this is a Secret Manager secret, not committed here.
#   - SALESCRIBE_ENFORCE_AUTH=1 forces the auth gate on locally (needs cloud
#     Application Default Credentials to verify ID tokens); =0 forces it off.
#     Production enforces automatically via Cloud Run's K_SERVICE.
# SALESCRIBE_SERVICE_TOKEN=
# SALESCRIBE_ENFORCE_AUTH=

# Firebase Web SDK config. NEXT_PUBLIC_* values get bundled into the client.
# These are PUBLIC by design — security comes from Firebase Auth + Firestore
# rules, not from keeping them secret.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA2GTt7OryaHOYx_-IOShaFQDfq-zOdeT4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=salescribe-2532a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=salescribe-2532a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=salescribe-2532a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=632214597362
NEXT_PUBLIC_FIREBASE_APP_ID=1:632214597362:web:7c85e45c95ff3c20bf2a6b
