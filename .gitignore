# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel (kept harmlessly even though we deploy to Firebase)
.vercel

# firebase
.firebase
firebase-debug.log
firestore-debug.log
*-debug.log
.runtimeconfig.json
# service-account keys and the working users list (real emails) — never commit
*serviceAccount*.json
/scripts/users.csv

# Demo-data test runs (--limit). The real public/demo-data.json IS committed
# so the deployed "Load demo data" button works; the sample is a local-only
# scratch file.
/public/demo-data-sample.json

# typescript
*.tsbuildinfo
next-env.d.ts
